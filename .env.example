# iLoveSurprises — Frontend Environment Configuration
#
# VITE_API_BASE_URL
#   Leave EMPTY for local development. The Vite dev server proxies /api and
#   /health to the local backend (http://localhost:3000) — see vite.config.ts.
#   Setting an absolute URL here bypasses that proxy and forces cross-origin
#   requests.
#
#   Set it ONLY to target an explicitly chosen deployed environment, e.g.
#     VITE_API_BASE_URL=https://api.ilovesurprises.com
#
#   There is no automatic fallback from local to production: if the local
#   backend is down, requests fail loudly rather than writing to production.
VITE_API_BASE_URL=https://api.ilovesurprises.com

# Public client configuration only. Never put secret or server-side keys here —
# everything in a VITE_* variable is embedded in the shipped JS bundle.
VITE_STRIPE_PUBLISHABLE_KEY=pk_CSlKP8W4mutoGSKsV4CxdgOMNklm4
VITE_PAYPAL_CLIENT_ID=

# Google Identity Services OAuth client ID (public by design).
# Required for Google sign-in. Must match GOOGLE_CLIENT_ID on the backend.
VITE_GOOGLE_CLIENT_ID=938360969554-ugn9qh315qrkpvsk1qcslse5o515ra0o.apps.googleusercontent.com
