# I Love Surprises - Frontend Standalone Environment Configuration
# Express backend API Base URL
VITE_API_BASE_URL=https://api.ilovesurprises.com

# Payment Gateway Configuration (Safe frontend public keys only - NEVER put secret keys in frontend)
# Stripe Publishable Key (e.g. pk_test_... or pk_live_...)
VITE_STRIPE_PUBLISHABLE_KEY=

# PayPal Client ID (Safe public client identifier)
VITE_PAYPAL_CLIENT_ID=
